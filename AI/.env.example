# Google AI Studio key for the movie description/cast section (optional).
# Without it the movie page still works, it just skips that section.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Scrape IMDb trailers with headless Chrome (needs Chrome installed). Off by default:
# the IMDb selectors in video_scrapper.py no longer match the current site.
ENABLE_TRAILERS=false
# Optional: path to a specific chromedriver; leave empty to let Selenium find one
CHROMEDRIVER_PATH=
AI_PORT=3001
# Comma-separated list of frontend origins allowed by CORS
CLIENT_ORIGIN=http://localhost:3000
